---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config';
import { siteUrl } from '../lib/url';
---

<Layout title="International">

  <section class="page-head">
    <div class="wrap">
      <div class="page-top">
        <p class="eyebrow">SÃO PAULO, BRAZIL</p>
        <span class="idx">SEC 07 / 08 — {SITE.name}</span>
      </div>
      <h1 class="display-md">Camera movement systems.</h1>
      <div class="mt-5">
        <p class="lede">SPECIALIZED OPERATIONS.<br />TECHNICAL SOLUTIONS.</p>
        <p class="meta mt-4">BASED IN SÃO PAULO, BRAZIL.</p>
      </div>
    </div>
  </section>

  <section class="band rt">
    <div class="wrap grid g5-7">
      <p class="eyebrow">MOVIMENTO DE CÂMERA NO BRASIL</p>
      <p class="quote">A Megatroper atua a partir de Guarulhos, na região metropolitana de São Paulo, com sistemas, operação e soluções técnicas para produções audiovisuais.</p>
    </div>
  </section>

  <section class="band rt">
    <div class="wrap grid g5-7">
      <p class="eyebrow">UMA OPERAÇÃO LOCAL ESPECIALIZADA</p>
      <div class="stack">
        <p class="lede">Para produções que chegam ao Brasil, a Megatroper pode ser o ponto de contato para necessidades especializadas de movimento de câmera.</p>
        <a class="link-more" href={siteUrl('/contato')}>Descrever um movimento</a>
      </div>
    </div>
  </section>

  <section class="band rt sec-tall">
    <div class="wrap">
      <p class="label">BASE</p>
      <h2 class="display-md mt-4">{SITE.base}</h2>
      <p class="lede mt-4">Uma base na região metropolitana de São Paulo.</p>
    </div>
  </section>

</Layout>