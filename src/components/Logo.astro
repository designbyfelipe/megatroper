---
// Logo Megatroper.
// O lockup oficial fica em /public/logo.png e é usado automaticamente
// (verificado em build). Enquanto o arquivo não existir, mantém o fallback
// temporário: quadrado amarelo + wordmark MEGATROPER.
import { existsSync } from 'node:fs';

interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const hasLogo = existsSync(new URL('../../public/logo.png', import.meta.url));
---

<a href="/" class="logo" aria-label="Megatroper — início">
  {hasLogo ? (
    <img
      src="/logo.png"
      alt=""
      class:list={['mark-img', size === 'footer' ? 'mark-img--lg' : null]}
      width="1000"
      height="149"
    />
  ) : (
    <>
      <span class="mark" aria-hidden="true"></span>
      <span class="word">MEGATROPER</span>
    </>
  )}
</a>