---
// Logo Megatroper.
// Header (padrão): lockup horizontal em /public/logo.png, usado automaticamente
// (verificado em build), com fallback temporário: quadrado amarelo + wordmark.
// Footer (variant="footer"): usa o logotipo completo original, preservando
// a assinatura institucional em aplicações de maior dimensão.
// O link aponta para a home do idioma atual.
import { existsSync } from 'node:fs';
import { pathFor, type Lang } from '../i18n/routes';
import { siteUrl } from '../lib/url';

interface Props {
  size?: 'header' | 'footer';
  variant?: 'header' | 'footer';
  lang?: Lang;
}

const { size = 'header', lang = 'pt' } = Astro.props;
const variant = Astro.props.variant ?? 'header';
const isFooter = variant === 'footer';
const homeLabel = lang === 'en' ? 'Megatroper — home' : 'Megatroper — início';
const homeHref = siteUrl(pathFor('home', lang));

const hasHeaderLogo = existsSync(new URL('../../public/logo.png', import.meta.url));
const hasFullLogo = existsSync(new URL('../../public/logo footer.png', import.meta.url));
const useFullLogo = isFooter && hasFullLogo;
---

<a href={homeHref} class="logo" aria-label={homeLabel}>
  {useFullLogo ? (
    <img
      src={siteUrl('/logo footer.png')}
      alt=""
      class="mark-img mark-img--full"
      width="1289"
      height="1221"
      loading="lazy"
    />
  ) : hasHeaderLogo ? (
    <img
      src={siteUrl('/logo.png')}
      alt=""
      class:list={['mark-img', isFooter || size === 'footer' ? 'mark-img--lg' : null]}
      width="1000"
      height="149"
      loading={isFooter ? 'lazy' : undefined}
    />
  ) : (
    <>
      <span class="mark" aria-hidden="true"></span>
      <span class="word">MEGATROPER</span>
    </>
  )}
</a>
