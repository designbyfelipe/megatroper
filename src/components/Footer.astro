---
import Logo from './Logo.astro';
import { SITE } from '../config';
import { pathFor, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { siteUrl } from '../lib/url';

interface Props {
  lang?: Lang;
  route?: RouteKey;
}

const { lang = 'pt', route = 'home' } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const nav = t.nav.map((item) => ({
  key: item.key,
  href: siteUrl(pathFor(item.key, lang)),
  label: item.label,
}));
const email = SITE.contact.email.trim();
---

<footer class="site">
  <div class="wrap footer-main">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="footer" lang={lang} />
        <p class="footer-tagline">{t.tagline}</p>
        <div class="footer-note">
          <i class="pixel" aria-hidden="true"></i>
          <span class="footer-loc">{t.location} · {t.since} {SITE.since}</span>
        </div>
      </div>

      <nav class="footer-col" aria-label={t.footerNav}>
        <span class="footer-h">{t.footerMap}</span>
        {nav.map((item) => (
          <a href={item.href} aria-current={item.key === route ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <div class="footer-col">
        <span class="footer-h">{t.footerContact}</span>
        {email && <a href={`mailto:${email}`}>{email}</a>}
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}</span>
      <span>{t.location}</span>
    </div>
  </div>
</footer>
