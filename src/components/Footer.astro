---
import Logo from './Logo.astro';
import { SITE } from '../config';

const year = new Date().getFullYear();
const nav = [
  { href: '/sistemas', label: 'Sistemas' },
  { href: '/trabalhos', label: 'Trabalhos' },
  { href: '/cases', label: 'Cases' },
  { href: '/pessoas', label: 'Pessoas' },
  { href: '/lab', label: 'Lab' },
  { href: '/internacional', label: 'Internacional' },
];
---

<footer class="site">
  <div class="wrap footer-main">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="footer" />
        <p class="footer-tagline">Movimento de câmera.</p>
        <div class="footer-note">
          <i class="pixel" aria-hidden="true"></i>
          <span class="footer-loc">{SITE.location} · Desde {SITE.since}</span>
        </div>
      </div>

      <nav class="footer-col" aria-label="Navegação">
        <span class="footer-h">Mapa</span>
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="footer-col">
        <span class="footer-h">Contato</span>
        <a href="/contato">Contato</a>
        <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
        <a class="link-more footer-cta" href="/contato">
          Descrever um movimento
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}</span>
      <span>{SITE.base}</span>
    </div>
  </div>
</footer>