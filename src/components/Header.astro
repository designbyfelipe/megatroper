---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { SITE } from '../config';
import { pathFor, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { siteUrl } from '../lib/url';

interface Props {
  lang?: Lang;
  route?: RouteKey;
}

const { lang = 'pt', route = 'home' } = Astro.props;
const t = ui[lang];
const links = t.nav.map((item) => ({
  key: item.key,
  href: siteUrl(pathFor(item.key, lang)),
  label: item.label,
}));
---

<header class="site">
  <div class="wrap header-inner">
    <Logo lang={lang} />
    <nav class="primary" aria-label={t.mainNav}>
      {links.map((l) => (
        <a href={l.href} aria-current={l.key === route ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <div class="header-tools">
      <LangSwitch lang={lang} route={route} />
      <button
        class="menu-btn"
        id="menuBtn"
        aria-label={t.openMenu}
        aria-controls="mobileNav"
        aria-expanded="false"
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobileNav" aria-label={t.mobileNav} aria-hidden="true">
  {links.map((l, i) => (
    <a href={l.href} aria-current={l.key === route ? 'page' : undefined}>
      <i>{String(i + 1).padStart(2, '0')}</i>
      {l.label.charAt(0) + l.label.slice(1).toLowerCase()}
    </a>
  ))}
  <div class="mobile-nav-foot">
    <span>{SITE.name}</span>
    <span>{t.location} · {t.since} {SITE.since}</span>
  </div>
</nav>

<script>
  function findMenu() {
    const nav = document.getElementById('mobileNav') as HTMLElement | null;
    return {
      btn: document.getElementById('menuBtn') as HTMLButtonElement | null,
      nav,
      links: Array.from(nav?.querySelectorAll('a') ?? []).filter(
        (a) => (a as HTMLAnchorElement).getAttribute('href')
      ) as HTMLAnchorElement[],
    };
  }

  function openMenu(btn: HTMLButtonElement, nav: HTMLElement) {
    nav.classList.add('open');
    nav.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', btn.dataset.closeLabel ?? 'Fechar menu');
    const first = nav.querySelector('a') as HTMLAnchorElement | null;
    first?.focus();
  }

  function closeMenu(btn: HTMLButtonElement, nav: HTMLElement) {
    nav.classList.remove('open');
    nav.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', btn.dataset.openLabel ?? 'Abrir menu');
    btn.focus();
  }

  function wireMenu() {
    const { btn, nav, links } = findMenu();
    if (!btn || !nav || btn.dataset.bound) return;
    btn.dataset.bound = '1';

    btn.addEventListener('click', () => {
      nav.classList.contains('open') ? closeMenu(btn, nav) : openMenu(btn, nav);
    });

    links.forEach((a) =>
      a.addEventListener('click', () => {
        const m = findMenu();
        if (m.btn && m.nav) closeMenu(m.btn, m.nav);
      })
    );
  }

  // Registrado uma única vez; re-inicializado a cada navegação via View Transitions.
  document.addEventListener('astro:page-load', wireMenu);

  document.addEventListener('keydown', (e) => {
    const { btn, nav, links } = findMenu();
    if (!btn || !nav) return;
    if (e.key === 'Escape' && nav.classList.contains('open')) {
      closeMenu(btn, nav);
    } else if (e.key === 'Tab' && nav.classList.contains('open')) {
      const first = links[0];
      const last = links[links.length - 1];
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
