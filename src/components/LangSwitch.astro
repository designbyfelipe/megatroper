---
// Seletor de idioma — visível em todas as páginas, no header.
// Cada link aponta para a versão equivalente da página atual.
// data-astro-reload força recarga completa para atualizar <html lang>,
// metadados e canonical sem depender do View Transitions.
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { siteUrl } from '../lib/url';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = ui[lang];
const ptHref = siteUrl(routes[route].pt);
const enHref = siteUrl(routes[route].en);
---

<div class="lang-switch" role="group" aria-label={t.langLabel}>
  <a
    href={ptHref}
    lang="pt-BR"
    hreflang="pt-BR"
    aria-label={t.ptName}
    aria-current={lang === 'pt' ? 'true' : undefined}
    data-set-lang="pt"
    data-astro-reload
  >PT</a>
  <span class="lang-sep" aria-hidden="true">|</span>
  <a
    href={enHref}
    lang="en"
    hreflang="en"
    aria-label={t.enName}
    aria-current={lang === 'en' ? 'true' : undefined}
    data-set-lang="en"
    data-astro-reload
  >EN</a>
</div>
